{
  "name": "@haejunhyun/related-notes",
  "version": "0.1.0",
  "description": "Right-sidebar Related list — ranks notes by direct link, same series (by episode distance) and shared concept tags (idf-weighted, folder-mirror tags excluded). Also strips the sidebar local graph panel, keeping only the ⌘G global graph modal.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    }
  },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "preact": "^10.28.2",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "quartz": {
    "name": "related-notes",
    "displayName": "Related Notes",
    "category": "component",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 15,
    "defaultEnabled": true,
    "defaultOptions": {
      "limit": 5,
      "excludeBacklinks": true
    },
    "components": {
      "RelatedNotes": {
        "displayName": "Related Notes",
        "defaultPosition": "right",
        "defaultPriority": 40
      }
    }
  }
}
